# Copy to .env for local testing:  set -a && . ./.env && set +a && python3 monitor.py
# In GitHub these live in Settings > Secrets and variables > Actions.

# --- secrets -------------------------------------------------------------
TAILSCALE_API_KEY=tskey-api-xxxxxxxxxxxx      # Tailscale API access token
TELEGRAM_BOT_TOKEN=123456:AA-xxxxxxxxxxxx     # from @BotFather
TELEGRAM_CHAT_ID=123456789                     # your chat id

# --- variables (all optional) -------------------------------------------
TAILNET=-                 # "-" = the token's default tailnet
TIMEZONE=UTC              # e.g. Asia/Kolkata - drives timestamps and analytics
DIGEST_HOUR=9             # local hour for the once-a-day analytics report
DIGEST_ENABLED=true
FLAP_CONFIRMATIONS=1      # polls that must agree before announcing a flip
ONLINE_SOURCE=auto        # auto | lastseen
ONLINE_THRESHOLD_SECONDS=900
MAX_GAP_SECONDS=7200      # ignore stat gaps longer than this (monitor outage)
NOTIFY_NEW_DEVICES=true
NOTIFY_REMOVED_DEVICES=true
STATE_FILE=state/state.json
LOG_DIR=logs
DRY_RUN=false             # true = print messages instead of sending them
